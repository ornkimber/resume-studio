{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resume Studio",
  "version": "0.1.0",
  "identifier": "org.resumestudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Resume Studio", "width": 1440, "height": 940, "minWidth": 980, "minHeight": 680 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/resume-engine"],
    "resources": { "../python/export_pdf_word.ps1": "export_pdf_word.ps1" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
